<%- include("../partials/header") %>

<section class="section">

<div class="container">

<div class="text-center mb-5">

<p class="text-muted">
GET IN TOUCH
</p>

<h1 class="section-title">
Contact Us
</h1>

<p class="text-muted">
Have a question? We're here to help.
</p>

</div>

<div class="row justify-content-center">

<div class="col-lg-7">

<div class="booking-card">

<form>

<div class="mb-3">

<label class="form-label">
Name
</label>

<input
class="form-control form-control-lg"
required
>

</div>

<div class="mb-3">

<label class="form-label">
Email
</label>

<input
type="email"
class="form-control form-control-lg"
required
>

</div>

<div class="mb-3">

<label class="form-label">
Message
</label>

<textarea
class="form-control"
rows="6"
required
></textarea>

</div>

<button
type="button"
class="primary-button border-0"
onclick="alert('Thank you! We will contact you soon.')"
>
Send Message
</button>

</form>

</div>

</div>

</div>

</div>

</section>

