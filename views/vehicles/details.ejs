<%- include("../partials/header") %>

<section class="section">

<div class="container">

<a href="/vehicles" class="text-decoration-none text-dark">
<i class="bi bi-arrow-left"></i>
Back to vehicles
</a>

<div class="row g-5 mt-2">

<div class="col-lg-7">

<img
src="<%= vehicle.image %>"
class="detail-image"
alt="<%= vehicle.name %>"
>

</div>

<div class="col-lg-5">

<span class="badge bg-dark mb-3">
<%= vehicle.category %>
</span>

<h1 class="display-5 fw-bold">
<%= vehicle.name %>
</h1>

<p class="text-muted">
<%= vehicle.description %>
</p>

<h2 class="fw-bold mt-4">
$<%= vehicle.price %>
<span class="fs-6 text-muted">/ day</span>
</h2>

<hr class="my-4">

<div class="row g-3">

<div class="col-6">

<div class="p-3 bg-white rounded-3">

<i class="bi bi-gear fs-4"></i>

<p class="mb-0 mt-2 text-muted">
Transmission
</p>

<strong>
<%= vehicle.transmission %>
</strong>

</div>

</div>

<div class="col-6">

<div class="p-3 bg-white rounded-3">

<i class="bi bi-fuel-pump fs-4"></i>

<p class="mb-0 mt-2 text-muted">
Fuel
</p>

<strong>
<%= vehicle.fuel %>
</strong>

</div>

</div>

<div class="col-6">

<div class="p-3 bg-white rounded-3">

<i class="bi bi-people fs-4"></i>

<p class="mb-0 mt-2 text-muted">
Seats
</p>

<strong>
<%= vehicle.seats %>
</strong>

</div>

</div>

<div class="col-6">

<div class="p-3 bg-white rounded-3">

<i class="bi bi-geo-alt fs-4"></i>

<p class="mb-0 mt-2 text-muted">
Location
</p>

<strong>
<%= vehicle.location %>
</strong>

</div>

</div>

</div>

<a
href="/book/<%= vehicle.id %>"
class="primary-button w-100 text-center mt-4"
>
Book This Vehicle
</a>

</div>

</div>

</div>

</section>

<%- include("../partials/footer") %>