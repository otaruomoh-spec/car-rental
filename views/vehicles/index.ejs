<%- include("../partials/header") %>

<section class="section">

<div class="container">

<div class="d-flex justify-content-between align-items-center mb-4">

<div>
<p class="text-muted mb-1">OUR FLEET</p>
<h1 class="section-title mb-0">Available Vehicles</h1>
</div>

<span class="text-muted">
<%= vehicles.length %> vehicles
</span>

</div>

<form action="/vehicles" method="GET" class="search-box mb-5">

<div class="row g-3">

<div class="col-md-6">

<label class="form-label">Search</label>

<input
type="text"
name="search"
value="<%= search %>"
class="form-control"
placeholder="Search vehicle..."
>

</div>

<div class="col-md-4">

<label class="form-label">Category</label>

<select name="category" class="form-select">

<option value="">All categories</option>

<option value="Premium" <%= category === "Premium" ? "selected" : "" %>>
Premium
</option>

<option value="Luxury" <%= category === "Luxury" ? "selected" : "" %>>
Luxury
</option>

<option value="SUV" <%= category === "SUV" ? "selected" : "" %>>
SUV
</option>

<option value="Economy" <%= category === "Economy" ? "selected" : "" %>>
Economy
</option>

</select>

</div>

<div class="col-md-2 d-flex align-items-end">

<button class="btn btn-dark w-100 py-2">
Search
</button>

</div>

</div>

</form>

<% if (vehicles.length === 0) { %>

<div class="text-center py-5">

<h3>No vehicles found</h3>

<p class="text-muted">
Try another search or category.
</p>

<a href="/vehicles" class="primary-button">
View All Vehicles
</a>

</div>

<% } %>

<div class="row g-4">

<% vehicles.forEach(vehicle => { %>

<div class="col-md-6 col-lg-4">

<div class="vehicle-card">

<img
src="<%= vehicle.image %>"
alt="<%= vehicle.name %>"
>

<div class="vehicle-content">

<div class="d-flex justify-content-between">

<span class="badge bg-light text-dark">
<%= vehicle.category %>
</span>

<span class="text-success">
● Available
</span>

</div>

<h3 class="mt-3">
<%= vehicle.name %>
</h3>

<p class="text-muted">

<i class="bi bi-gear"></i>
<%= vehicle.transmission %>

&nbsp; · &nbsp;

<i class="bi bi-people"></i>
<%= vehicle.seats %> seats

</p>

<div class="d-flex justify-content-between align-items-center">

<div>

<strong class="vehicle-price">
$<%= vehicle.price %>
</strong>

<span class="text-muted">/day</span>

</div>

<a
href="/vehicles/<%= vehicle.id %>"
class="btn btn-dark rounded-pill px-4"
>
Details
</a>

</div>

</div>

</div>

</div>

<% }) %>

</div>

</div>

</section>

<%- include("../partials/footer") %>