<%- include("../partials/header") %>

<section class="section">

<div class="container">

<div class="row justify-content-center">

<div class="col-lg-7">

<div class="booking-card text-center">

<div class="display-1 text-success">
✓
</div>

<h1 class="fw-bold">
Booking Received!
</h1>

<p class="text-muted">
Thank you, <%= booking.customerName %>.
Your reservation has been received.
</p>

<hr>

<div class="text-start">

<p>
<strong>Booking ID:</strong>
<%= booking.id %>
</p>

<p>
<strong>Vehicle:</strong>
<%= booking.vehicleName %>
</p>

<p>
<strong>Pick-up:</strong>
<%= booking.pickupDate %>
</p>

<p>
<strong>Drop-off:</strong>
<%= booking.dropoffDate %>
</p>

<p>
<strong>Location:</strong>
<%= booking.location %>
</p>

<p>
<strong>Duration:</strong>
<%= booking.days %> day(s)
</p>

<h3 class="mt-4">
Total: $<%= booking.total %>
</h3>

<span class="badge bg-warning text-dark">
Pending
</span>

</div>

<div class="d-flex gap-2 mt-4">

<a
href="/vehicles"
class="primary-button flex-fill text-center"
>
Browse Vehicles
</a>

<a
href="/my-booking"
class="btn btn-outline-dark rounded-pill flex-fill"
>
My Bookings
</a>

</div>

</div>

</div>

</div>

</div>

</section>

<%- include("../partials/footer") %>