<%- include("../partials/header") %>

<section class="section">

<div class="container">

<div class="row g-5">

<div class="col-lg-5">

<img
src="<%= vehicle.image %>"
class="detail-image"
alt="<%= vehicle.name %>"
>

<h2 class="mt-4">
<%= vehicle.name %>
</h2>

<p class="text-muted">
<%= vehicle.description %>
</p>

<h3>
$<%= vehicle.price %>
<span class="fs-6 text-muted">/ day</span>
</h3>

</div>

<div class="col-lg-7">

<div class="booking-card">

<p class="text-muted mb-1">
RESERVATION
</p>

<h1 class="fw-bold mb-4">
Book Your Vehicle
</h1>

<form action="/book" method="POST">

<input
type="hidden"
name="vehicleId"
value="<%= vehicle.id %>"
>

<div class="row g-3">

<div class="col-md-6">

<label class="form-label">
Full Name
</label>

<input
type="text"
name="name"
class="form-control form-control-lg"
required
>

</div>

<div class="col-md-6">

<label class="form-label">
Phone Number
</label>

<input
type="tel"
name="phone"
class="form-control form-control-lg"
required
>

</div>

<div class="col-12">

<label class="form-label">
Email Address
</label>

<input
type="email"
name="email"
class="form-control form-control-lg"
required
>

</div>

<div class="col-md-6">

<label class="form-label">
Pick-up Date
</label>

<input
type="date"
name="pickupDate"
id="pickupDate"
class="form-control form-control-lg"
required
>

</div>

<div class="col-md-6">

<label class="form-label">
Drop-off Date
</label>

<input
type="date"
name="dropoffDate"
id="dropoffDate"
class="form-control form-control-lg"
required
>

</div>

<div class="col-12">

<label class="form-label">
Pick-up Location
</label>

<select
name="location"
class="form-select form-select-lg"
required
>

<option value="">
Select location
</option>

<option>
Keflavik International Airport
</option>

<option>
Reykjavik
</option>

<option>
Reykjavik City Centre
</option>

</select>

</div>

</div>

<div class="bg-light p-4 rounded-3 mt-4">

<div class="d-flex justify-content-between">

<span>
Vehicle
</span>

<strong>
<%= vehicle.name %>
</strong>

</div>

<div class="d-flex justify-content-between mt-2">

<span>
Daily rate
</span>

<strong>
$<%= vehicle.price %>
</strong>

</div>

<div class="d-flex justify-content-between mt-2">

<span>
Estimated total
</span>

<strong id="totalPrice">
$<%= vehicle.price %>
</strong>

</div>

</div>

<button
class="primary-button border-0 w-100 mt-4"
type="submit"
>
Confirm Booking
</button>

</form>

</div>

</div>

</div>

</div>

</section>

<script>

const pickup = document.getElementById("pickupDate");
const dropoff = document.getElementById("dropoffDate");
const total = document.getElementById("totalPrice");

const dailyPrice = <%= vehicle.price %>;

function calculateTotal() {

    if (!pickup.value || !dropoff.value) {
        total.textContent = "$" + dailyPrice;
        return;
    }

    const start = new Date(pickup.value);
    const end = new Date(dropoff.value);

    const difference = end - start;

    let days = Math.ceil(
        difference / (1000 * 60 * 60 * 24)
    );

    if (days < 1) days = 1;

    total.textContent =
        "$" + (days * dailyPrice);

}

pickup.addEventListener("change", calculateTotal);
dropoff.addEventListener("change", calculateTotal);

</script>

<%- include("../partials/footer") %>